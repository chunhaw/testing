@relative_mode 
	gcode = 91
	{nb gcode}

endp
;-------------------------------------------------------------------------------------------------------------------------

@absolute_mode 
	gcode = 90
	{nb gcode}

endp
;-------------------------------------------------------------------------------------------------------------------------

@machine_plane	
	if machine_plane == XY
		gcode = 17
	endif
	if machine_plane == YZ
		gcode = 18
	endif
	if machine_plane == ZX
		gcode = 19
	endif
	
	{gcode:'<G>2/2.0(p)'}

endp
