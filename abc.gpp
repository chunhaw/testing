@init_post	

	;====================================================== FORMAT ============================================================
	global string spin_f 
	global string xlnext_f ylnext_f zlnext_f 
	global string xonext_f yonext_f zonext_f
	global string xhnext_f yhnext_f zhnext_f 
	global string bpos_f anext_f bnext_f

	;========================================================= TIME ===========================================================
	global numeric n_TimeSecs		; Time: Seconds
	global numeric n_TimeMins		; Time: Minutes
	global numeric nTimeHrs			; Time: Hours
	global numeric n_TimeAccSecs	; Time: Accumulate Seconds	
	global numeric n_TimeAccMins	; Time: Accumulate Minutes
	global numeric n_TimeAccHrs		; Time: Accumlate Hours

	;====================================================== TRANSFORM ========================================================
	global numeric n_G52XLocalCS	; Transform: G52 X Shifting
	global numeric n_G52YLocalCS	; Transform: G52 Y Shifting
	global numeric n_G52ZLocalCS	; Transform: G52 Z Shifting
	global numeric n_AngleRotUpd	; Transform: Update Latest Rotation Angle


	;===================================================== JOB TOOL COOLANT ======================================================
	global logical b_FirstRapid		; Status Update: 'True' if First Rapid Move of A Job
	global logical b_CoolantUsed	;
	global logical b_CoolantOn		; Status Update: 'True' if Coolant is On
	global logical b_SpindleOn		; Status Update: 'True' if Spindle is On
	global logical b_FirstJob		; Status Update: 'True' if First Job
	global logical b_ChangeTool		; Status Update: 'True' if Tool Change
	global integer i_CoolantOnCode 	; Coolant: Current Coolant Code
	global integer i_CoolantOffCode	; Coolant: Current Coolant Off Code

	;======================================================= KINEMATICS ==========================================================
	global logical b_IndexOn		; Kinematics:	'True' if G68.2 is active 
	global logical b_X5on 			; Kinematics:	'True' if G43.4 is active

	;======================================================== TURNING ============================================================
	global integer i_SavedJobMachineType

	;========================================================= GENERAL ===========================================================
	global numeric n_XRefPoint		; Reference: X Reference Point
	global integer i_TrcLvl			; Trace: Trace Level
	global integer i_ToolBlkNum		; Blknum: Blknum for Tool
	global integer i_JobBlkNum		; Blknum: Blknum for Job
	global string pp_version

	;========================================================== PROBE ============================================================

	global logical b_ProbeFirstMove 



  
	;-----GPPL variables -------
	pre_processor   = 'ISO'
	numeric_def_f   = '5.3'
	integer_def_f   = '5/2.0(p)'        ; Especially for Tool T##
	gcode_f         = '<G>2/2.0(p)< >'        ; G##
	mcode_f         = '<M>2/2.0(p)< >'        ; M##
	feed_f          = '<F>4.3< >'
	spin_f			= '<S>5.3(p)'
	apos_f			= '<C>5.3< >'
	bpos_f			= '<A>5.3< >'
	anext_f			= apos_f
	bnext_f			= bpos_f
	;tool_diameter_f = '5.3/1'     
	blknum_f        = '5.0(p)'
	blknum_gen      = False
	blknum_exist    = True
	blknum          = 101
	blknum_delta    = 1
	blknum_max      = 9999999
	remove_blanks   = False
	gcode_space     = False	
	i_ToolBlkNum = 0
	i_JobBlkNum = 100
	pp_version = 'V0.0 - 2025-04-28' 

	;----- General --------------
	n_XRefPoint 		= -250

endp
