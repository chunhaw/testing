@Usr_Header
	{'(PART NAME = ' upper(part_name) ')'}
	{nb '(POSTPROCESSOR = ' pp_version ')'}
	{nb '(PROGRAMMER = ' upper(user_account) ')'}
	{nb}
	{nb '(--------- PROGRAM START ---------)'}
	{nb}
	call @Usr_BrotherStart
	{nb}
endp
;=======================================================================================================================================================

@Usr_BrotherStart
	{nb 'M353'}	;Thermal Displacement Compensation X, Y, Z
	call @Usr_ShowerOn
endp
;=======================================================================================================================================================

@Usr_OptStop
	{nb'M01'}
endp
;=======================================================================================================================================================

@Usr_CoolantOn
	local integer coolant_count

	i_CoolantOffCode = 9

	if Flood_coolant == True
		i_CoolantOnCode = 8
		coolant_count = coolant_count + 1
	endif

	if Mist_coolant == True
		i_CoolantOnCode = 7
		coolant_count = coolant_count + 1
	endif

	if Air_Blast_coolant == True
		i_CoolantOnCode = 32
		coolant_count = coolant_count + 1
	endif
	
	if Through_coolant == True
		i_CoolantOnCode = 494
		i_CoolantOffCode = 495
		coolant_count = coolant_count + 1
	endif

	if coolant_count != 1
		i_CoolantOnCode = 8
		i_CoolantOffCode = 9
	endif

	if b_CoolantOn == False
		{nb i_CoolantOnCode:mcode_f}
		b_CoolantOn = True
	endif

endp
;=======================================================================================================================================================

@Usr_CoolantOff
	if b_CoolantOn
		mcode = i_CoolantOffCode
		{nb mcode}
		b_CoolantOn = False
	endif 
endp
;=======================================================================================================================================================

@Usr_ChangeToolReset
	i_ToolBlkNum = i_ToolBlkNum + 1
	if first_tool == True
		call @Usr_OptStop
		{nb}
		{nb 'N' i_ToolBlkNum}
		call @Usr_ChangeTool
	else
		call @Usr_CoolantOff
		call @Usr_SpindleOff
		call @Usr_ZeroReturnZ
		call @Usr_ZeroReturnY
		call @Usr_OptStop
		{nb}
		{nb 'N' i_ToolBlkNum:'5.3(p)'}
		call @Usr_ChangeTool
	endif
	{nb}
	call @Usr_ResetSoft
endp
;=======================================================================================================================================================

@Usr_ChangeTool
	{nb 'T' tool_number ' M6'}
	skipline = False
	call @tool_description
endp
;=======================================================================================================================================================

@Usr_ToolCallPrepost

	if job_machine_type == Milling
		if !X5_job
			if position == 1
				call @Usr_IndexOff
				{nb 'G90 G' (53+home_number) ' G0 ' xlnext ylnext}
				{nb 'G43 G0 ' zlnext 'H'tool_number}
			else 
				{nb (53+home_number):gcode_f}
				call @Usr_AxisRot
				call @Usr_IndexOn
				{nb 'G90 G0 ' xlnext ylnext}
				{nb 'G43 G0 ' zlnext 'H'tool_number}
			endif
		else 
			call @Usr_IndexOff
			{nb 'G90 G' (53+home_number)' G0 ' xhnext yhnext}
			{nb 'G43 G0 Z' clearance_plane 'H' tool_number}
			call @Usr_X5On
		endif
	endif 

	if job_machine_type == Turning 
		if turning_plane_rotation == 0
			{nb (53+mac_number):gcode_f (18):gcode_f}
		endif

		if abs(turning_plane_rotation) == 90
			{nb (53+mac_number):gcode_f (19):gcode_f}
		endif 

		{nb 'T' tool_number ' ' (6):mcode_f}
		{nb 'G90 G0 ' xonext yonext machine_b_value:bpos_f}
		call @Usr_TurnSpindleOn
		call @Usr_TurnToolSide
		skipline = False
		call @Usr_CoolantOn
		{nb 'G143 G0 ' zonext 'H'tool_number}
	endif

endp
;=======================================================================================================================================================
@Usr_JobName
	i_JobBlkNum = i_JobBlkNum + 1
	{nb 'N' i_JobBlkNum:'5.3(p)'}
	{nb '(' upper(job_name) ' | C' first_axis_angle ' | A' second_axis_angle ')'}
endp
;=======================================================================================================================================================

@Usr_AxisRot
	{nb 'G90G0C' first_axis_angle 'A' second_axis_angle}	
endp
;=======================================================================================================================================================

@Usr_TurnToolSide
	if turning_plane_rotation == 0
		if cutting_direction == 1	; LEFT TOOL
		endif 
		if cutting_direction == 2	; RIGHT TOOL
		endif
	endif 

	if abs(turning_plane_rotation) == 90
		if cutting_direction == 1	; LEFT TOOL
		endif 
		if cutting_direction == 2	; RIGHT TOOL
		endif
	endif 
endp 
;=======================================================================================================================================================

@Usr_TurnSpindleOn
	if spin_direction == cw 
		mcode = 303
	else 
		mcode = 304
	endif 

	if !b_SpindleOn 
		{spin}
		call @Usr_TurnMillMode
		{mcode}
	endif 
endp 
;=======================================================================================================================================================

@Usr_TurnSpindleOff 
	if b_SpindleOn
		mcode = 305
		{nb mcode}
		b_SpindleOn = False
	endif
endp 
;=======================================================================================================================================================

@Usr_SpindleOn
	if spin_direction == cw
		mcode = 3
	else
		mcode = 4
	endif

	if !b_SpindleOn 
		{' ' spin}
		call @Usr_TurnMillMode
		{mcode}
	endif 
endp
;=======================================================================================================================================================

@Usr_SpindleOff
	if b_SpindleOn
		mcode = 5
		{nb mcode}
		b_SpindleOn = False
	endif
endp
;=======================================================================================================================================================

@Usr_TurnMillMode
	if job_machine_type == Milling 
		if i_SavedJobMachineType <> job_machine_type
			{' ' (141):mcode_f}
		endif
	endif 

	if job_machine_type == Turning 
		if i_SavedJobMachineType <> job_machine_type
			{' ' (142):mcode_f}
		endif 
	endif 
endp 
;=======================================================================================================================================================

@Usr_XYZFormat
	if job_machine_type == Milling 
		xlpos_f  = '<X>5.3< >'
		ylpos_f  = '<Y>5.3< >'
		zlpos_f  = '<Z>5.3< >'

		xlnext_f = xlpos_f
		ylnext_f = ylpos_f
		zlnext_f = zlpos_f

		xhpos_f  = xlpos_f 
		yhpos_f  = ylpos_f
		zhpos_f  = zlpos_f
 
		xhnext_f = xlpos_f
		yhnext_f = ylpos_f
		zhnext_f = zlpos_f

	endif 

	if job_machine_type == Turning 
		if turning_plane_rotation == 0
			xopos_f   = '<X>5.3(*2)< >'
			yopos_f   = '<Y>5.3< >'
			zopos_f   = '<Z>5.3< >'

			xonext_f  = xopos_f
			yonext_f  = yopos_f
			zonext_f  = zopos_f

		endif 

		if abs(turning_plane_rotation) == 90
			xopos_f  = '<Y>5.3< >'
			yopos_f  = '<X>5.3< >'
			zopos_f  = '<Z>5.3< >'

			xonext_f = xopos_f
			yonext_f = yopos_f
			zonext_f = zopos_f
		endif 
		
	endif 
endp 
;=======================================================================================================================================================

@Usr_IndexOff
	if b_IndexOn
		{nb 'G69'}
		b_IndexOn = false
	endif
endp 
;=======================================================================================================================================================

@Usr_IndexOn
	if !b_IndexOn
		{nb 'G68.2 ' shift_x:xlpos_f shift_y:ylpos_f shift_z:zlpos_f 'I' first_plane_angle ' J' second_plane_angle ' K' third_plane_angle}
		{nb 'G53.1'}
		b_IndexOn = true
	endif 
endp 
;=======================================================================================================================================================

@Usr_X5On 
	if !b_X5On
		{nb (49):gcode_f}
		{nb 'G43.4 ' xhnext yhnext zhnext anext bnext}
		b_X5On = true
	endif
endp 
;=======================================================================================================================================================

@Usr_X5Off 
	if b_X5On
		{nb (49):gcode_f}
		b_X5On = false 
	endif 
endp
;=======================================================================================================================================================



;=======================================================================================================================================================
;================================================================   PROBING   ==========================================================================
;=======================================================================================================================================================

; ** 8810 - Move
; ** ** 8811 - Single Face
; ** 8812 - Web / Pocket 
; -------------------------------8814 - Bore / boss 
; ** 8815 - Internal Corner 
; ** 8816 - External Corner 
; ------------------------------- 8817 - 5 points rectangcle
; ------------------------------- 8818 - 4th axis
; 8819 - PCD bore / boss 
; ------------------------------- 8820 - Stock Allowance 
; ** 8821 - Angled Single Face (AD input / XYZ Input)
; ** 8822 - Angle Web / pocket 
; ** 8823 - 3 Points bore / boss 
; ** 8834 - feature to feature 
; 8843 - XY angle measure


@start_probe
	call @Usr_XYZFormat

	{nb 'G65 P8832 '}		; PROBE ON
	b_ProbeFirstMove = true
endp 
;=======================================================================================================================================================

@move_prb
	if b_ProbeFirstMove
		{nb 'G65 P8810 ' xlnext ylnext}
		{nb 'G65 P8810 ' zlnext}
		b_ProbeFirstMove = false
	else 
		{nb 'G65 P8810 ' [xlpos] [ylpos] [zlpos]}
	endif 	
endp      
;=======================================================================================================================================================

@line_prb
	{nb 'G65 P8810 ' [xlpos] [ylpos] [zlpos]}
endp        
;=======================================================================================================================================================

@prb_cyc_xyz_plan
	; PRB_RepToches:1 
	; PRB_FirstCycle:1 
	; PRB_LastCycle:1 
	; PRB_TP1_X:272.850T PRB_TP1_Y:9.261T PRB_TP1_Z:-15.000T 
	; PRB_RetractDist:12.000 PRB_Dir:-1 
	; PRB_StartAngle:0.000 
	; PRB_Overtravel:10.000F 

	if ProbeCycle == 'PRB_X_PLANE' 
		{nb 'G65 P8811 X' PRB_TP1_X }

		if PRB_Overtravel <> 10
			{' Q' PRB_Overtravel}
		endif 
	endif 

	if ProbeCycle == 'PRB_Y_PLANE' 
		{nb 'G65 P8811 Y' PRB_TP1_Y }

		if PRB_Overtravel <> 10
			{' Q' PRB_Overtravel}
		endif 
	endif 

	if ProbeCycle == 'PRB_Z_PLANE' 
		{nb 'G65 P8811 Z' PRB_TP1_Z }

		if PRB_Overtravel <> 4
			{' Q' PRB_Overtravel}
		endif 
	endif 
		
	if ActionProbeType == 1				;WORK OFFSET
		{' S' mac_number:'5.3(p)'}
	endif 
endp 
;=======================================================================================================================================================

@prb_cyc_hol_cyl 
	; ProbeCycle:'PRB_HOLE' 
	; PRB_RepToches:1 
	; PRB_NumTouchPoints:3 
	; PRB_FirstCycle:1 
	; PRB_LastCycle:1 
	; PRB_CP_X:0.000T PRB_CP_Y:337.850T PRB_CP_Z:-30.000T 
	; PRB_StartHeight:-30.000 
	; PRB_RetractDist:12.000 
	; PRB_StartAngle:0.000 
	; PRB_EndAngle:360.000 
	; PRB_DeltaAngle0:120.000 
	; PRB_DiamCirMsr:80.000 
	; PRB_Overtravel:10.000F 


	if ProbeCycle == 'PRB_EXT_ARC' OR ProbeCycle == 'PRB_INT_ARC'
		{nb 'G65 P8823 D' (PRB_Radius*2) ' A' PRB_StartAngle}
	else 
		{nb 'G65 P8823 D' PRB_DiamCirMsr ' A' PRB_StartAngle}
	endif 

	if (PRB_StartAngle + PRB_DeltaAngle0) > 180
		{' B' ((PRB_StartAngle + PRB_DeltaAngle0)-360)}
	else 
		{' B' PRB_DeltaAngle0}
	endif 

	if (PRB_StartAngle + PRB_DeltaAngle0 + PRB_DeltaAngle0) > 180
		{' C' ((PRB_StartAngle + PRB_DeltaAngle0 + PRB_DeltaAngle0)-360)}
	else
		{' C' PRB_EndAngle}
	endif 

	if PRB_Overtravel <> 10
		{' Q' PRB_Overtravel}
	endif 

	if ProbeCycle == 'PRB_CYLINDER' OR ProbeCycle == 'PRB_EXT_ARC'
		{' R' PRB_RetractDist}
	endif 

	if ProbeCycle == 'PRB_HOLE_BOSS'
		{' R-' PRB_RetractDist}
	endif 

	if ActionProbeType == 1				;WORK OFFSET
		{' S' mac_number:'5.3(p)'}
	endif 
		
endp 
;=======================================================================================================================================================

@prb_cyc_cor
	; ProbeCycle:'PRB_EXT_CORNER' 
	; PRB_RepToches:1 
	; PRB_FirstCycle:1 
	; PRB_LastCycle:1 
	; PRB_CP_X:272.850T PRB_CP_Y:-247.850T PRB_CP_Z:-15.000T 
	; PRB_DX1:10.000T 
	; PRB_DY1:10.000T 
	; PRB_DX2:0.000T 
	; PRB_DY2:0.000T 
	; PRB_RetractDist_X:12.000 PRB_Dir_X:-1 
	; PRB_RetractDist_Y:12.000 PRB_Dir_Y:1 
	; PRB_StartAngle:0.000 
	; PRB_Overtravel:10.000F 

	local numeric Probe_i Probe_j 
	Probe_i = PRB_DX2 
	Probe_j = PRB_DY2

	if ProbeCycle == 'PRB_EXT_CORNER' 
		{nb 'G65 P8816 '}
	endif 

	if ProbeCycle == 'PRB_INT_CORNER'
		{nb 'G65 P8815'}
	endif 

	{'X' PRB_CP_X ' Y' PRB_CP_Y Probe_i:'< I>5.3(d)' Probe_j:'<J>5.3(d)'}
endp 
;=======================================================================================================================================================

@prb_cyc_bos_pckt

	{nb 'G65 P8812'}
	; ProbeCycle:'PRB_POCKET' 
	; PRB_AlongAxis:'Y' 
	; PRB_RepToches:1 
	; PRB_FirstCycle:1 
	; PRB_LastCycle:1 
	; PRB_TP2_X:-362.850T PRB_TP2_Y:-42.199T PRB_TP2_Z:-20.000T 
	; PRB_TPY2_Y:47.801T 
	; PRB_LengthY:90.000T 
	; PRB_StartHeight:-20.000 
	; PRB_RetractDist:12.000 
	; PRB_StartAngle:90.000 
	; PRB_Overtravel:10.000F 

	if ProbeCycle == 'PRB_POCKET'
		if PRB_AlongAxis == 'XY'
			print 'Move Along XY Not Supported!!'
		endif 
		if PRB_AlongAxis == 'X'
			{' X' PRB_LengthX}
		endif
		if PRB_AlongAxis == 'Y'
			{' Y' PRB_LengthY}
		endif 
	endif



	; ProbeCycle:'PRB_BOSS' 
	; PRB_AlongAxis:'Y' 
	; PRB_RepToches:1 
	; PRB_FirstCycle:1 
	; PRB_LastCycle:1 
	; PRB_TP2_X:-362.850T PRB_TP2_Y:-247.850T PRB_TP2_Z:-30.235T 
	; PRB_TPY2_Y:-127.850T 
	; PRB_LengthY:120.000T 
	; PRB_StartHeight:25.000 
	; PRB_RetractDist:12.000 
	; PRB_StartAngle:90.000 
	; PRB_Overtravel:10.000F 

	if ProbeCycle == 'PRB_BOSS'
		if PRB_AlongAxis == 'XY'
			print 'Move Along XY Not Supported!!'
		endif 
		if PRB_AlongAxis == 'X'
			{' X' PRB_LengthX}
		endif
		if PRB_AlongAxis == 'Y'
			{' Y' PRB_LengthY}
		endif 
		{' ' PRB_StartHeight:zlpos_f 'R' PRB_RetractDist}
	endif


	; ProbeCycle:'PRB_POCKET_BOSS' 
	; PRB_AlongAxis:'Y' 
	; PRB_RepToches:1 
	; PRB_FirstCycle:1 
	; PRB_LastCycle:1 
	; PRB_TP2_X:-362.850T PRB_TP2_Y:137.850T PRB_TP2_Z:-30.000T 
	; PRB_TPY2_Y:237.850T 
	; PRB_LengthY:100.000T 
	; PRB_StartHeight:20.000 
	; PRB_RetractDist:10.000 
	; PRB_StartAngle:90.000 
	; PRB_Overtravel:10.000F 

	if ProbeCycle == 'PRB_POCKET_BOSS'
		if PRB_AlongAxis == 'XY'
			print 'Move Along XY Not Supported!!'
		endif 
		if PRB_AlongAxis == 'X'
			{' X' PRB_LengthX}
		endif
		if PRB_AlongAxis == 'Y'
			{' Y' PRB_LengthY}
		endif 
		{' ' PRB_StartHeight:zlpos_f 'R-' PRB_RetractDist}
	endif
	

	if ActionProbeType == 1
		{' S' mac_number:'5.3(p)'}
	endif
endp 
;=======================================================================================================================================================

@end_probe 
	{nb 'G65 P8833'}
	b_ProbeFirstMove = true

	call @Usr_ProbeMacro
endp
;=======================================================================================================================================================

@Usr_ProbeMacro 
	local integer ErrCode
	local numeric NominalDia, LowerLimit, UpperLimit, NominalPt   ;Hole, Cylinder, Point
	local numeric NominalWidthX, NominalWidthY ,LowerLimitX, LowerLimitY, UpperLimitX, UpperLimitY  ;Boss, Pocket
	local numeric TolAdj 

	if ProbeCycle eq 'PRB_X_PLANE' 
		{nb '#150 = #135'}
		ErrCode = 5
		NominalPt = PRB_TP1_X + ((MinCoordToleranceX+MaxCoordToleranceX)/2)
		LowerLimit = PRB_TP1_X + MinCoordToleranceX
		UpperLimit = PRB_TP1_X + MaxCoordToleranceX

	elseif ProbeCycle eq 'PRB_Y_PLANE'
		{nb '#150 = #136'}
		ErrCode = 6
		NominalPt = PRB_TP1_Y + ((MinCoordToleranceY+MaxCoordToleranceY)/2)
		LowerLimit = PRB_TP1_Y + MinCoordToleranceY
		UpperLimit = PRB_TP1_Y + MaxCoordToleranceY
	endif

	if ProbeCycle eq 'PRB_X_PLANE' OR ProbeCycle eq 'PRB_Y_PLANE'
		if b_ProbeIntWall
			{nb 'IF [#150 GE ' UpperLimit '] GOTO ' ((i_ToolBlkNum*1000)+1)} ;Overcut
			{nb 'IF [#150 LE ' LowerLimit '] GOTO ' ((i_ToolBlkNum*1000)+2)} ;Undercut
			{nb 'GOTO ' ((i_ToolBlkNum*1000)+3)}  ;OK
			{nb}
			{nb 'N' ((i_ToolBlkNum*1000)+1)}   ;Overcut
			if b_ProbeAlarmReport 
				{nb '#151 = 1'}
			else 
				{nb '#151 = 0'}
			endif 
			{nb 'IF [#151 EQ 1] GOTO 999'}
			call @Usr_ProbeAlarm(ErrCode)
			{nb 'N' ((i_ToolBlkNum*1000)+2)}   ;Undercut
			{nb 'G91G10L11P#4120R' '[#150-'NominalPt']'}
			{nb 'GOTO ' i_JobBlkNum:'5.3(p)'}
		else 
			{nb 'IF [#150 LE ' LowerLimit '] GOTO ' ((i_ToolBlkNum*1000)+1)} ;Overcut`
			{nb 'IF [#150 GE ' UpperLimit '] GOTO ' ((i_ToolBlkNum*1000)+2)} ;Undercut
			{nb 'GOTO ' ((i_ToolBlkNum*1000)+3):'5.3(p)'}  ;OK
			{nb}
			{nb 'N' ((i_ToolBlkNum*1000)+1)}   ;Overcut
			if b_ProbeAlarmReport 
				{nb '#151 = 1'}
			else 
				{nb '#151 = 0'}
			endif 
			{nb 'IF [#151 EQ 1] GOTO ' ((i_ToolBlkNum*1000)+3) }
			call @Usr_ProbeAlarm(ErrCode)
			{nb 'N' ((i_ToolBlkNum*1000)+2)}   ;Undercut
			{nb 'G91G10L11P#4120R' '['NominalPt'-#150]'}
			{nb 'GOTO ' i_JobBlkNum:'5.3(p)'}
			{nb}
			{nb 'N' ((i_ToolBlkNum*1000)+3) }
		endif
	endif 

	if ProbeCycle == 'PRB_Z_PLANE'
		{nb '#150 = #137'}
		ErrCode = 7
		NominalPt = PRB_TP1_Z
		LowerLimit = PRB_TP1_Z + MinCoordToleranceZ
		UpperLimit = PRB_TP1_Z + MaxCoordToleranceZ

		{nb 'IF [#150 LE ' LowerLimit '] GOTO ' ((i_ToolBlkNum*1000)+1)} ;Overcut
		{nb 'IF [#150 GE ' UpperLimit '] GOTO ' ((i_ToolBlkNum*1000)+2)} ;Undercut
		{nb 'GOTO '((i_ToolBlkNum*1000)+3)}  
		{nb}
		{nb 'N' ((i_ToolBlkNum*1000)+1)}   ;Overcut
		if b_ProbeAlarmReport 
			{nb '#151 = 1'}
		else 
			{nb '#151 = 0'}
		endif 
		{nb 'IF [#151 EQ 1] GOTO ' ((i_ToolBlkNum*1000)+3) }
		call @Usr_ProbeAlarm(ErrCode)
		{nb 'N' ((i_ToolBlkNum*1000)+2)}   ;Undercut
		{nb 'G91G10L10P#175R' '['NominalPt'-#150]'}
		{nb 'G90'}
		{nb 'GOTO ' i_JobBlkNum:'5.3(p)'}
		{nb}
		{nb 'N' ((i_ToolBlkNum*1000)+3) }
	endif 


	if ProbeCycle eq 'PRB_EXT_CORNER' or ProbeCycle eq 'PRB_INT_CORNER'
		{nb '#150 = #135'} ;X result
		{nb '#151 = #136'} ;Y result
		{nb '#152 = #140'} ;X Error
		{nb '#153 = #141'} ;Y Error
	endif
endp 
;=======================================================================================================================================================

@Usr_ProbeAlarm(integer ErrCode)
	local string ErrMsg
	if ErrCode eq 1
		ErrMsg = 'HOLE/INT-DIA'
	endif
	if ErrCode eq 2
		ErrMsg = 'CYL/EXT-DIA'
	endif  
	if ErrCode eq 3
		ErrMsg = 'EXT-WIDTH'
	endif 
	if ErrCode eq 4
		ErrMsg = 'INT-WIDTH'
	endif   
	if ErrCode eq 5
		ErrMsg = 'POINT X'
	endif
	if ErrCode eq 6
		ErrMsg = 'POINT Y'
	endif
	if ErrCode eq 7
		ErrMsg = 'POINT Z'
	endif

	call @Usr_ProbeReport

	{nb '#3000=' ErrCode:'5.3(p)' '(' ErrMsg ': OUT OF TOL)'}
	{nb 'GOTO 999'}
	{nb}
endp 
;=======================================================================================================================================================

@Usr_ProbeReport

	if ProbeCycle eq 'PRB_X_PLANE'
		{nb 'DPRNT[OPERATION**'ProbeCycle'**/**'upper(probe_name)']'}
		{nb 'DPRNT[**POS-X:*'PRB_TP1_X'**/**TOL-MIN:*'MinCoordToleranceX'**/**TOL-MAX:*'MaxCoordToleranceX']'}
		{nb 'DPRNT[**POS-X-MEASURE:*#150[53]**/**POS-X-ERR:*#140[53]*]'}
		{nb 'DPRNT[]'}
		{nb 'PCLOS'}      
	endif

	if ProbeCycle eq 'PRB_Y_PLANE'
		{nb 'DPRNT[OPERATION**'ProbeCycle'**/**'upper(probe_name)']'}
		{nb 'DPRNT[**POS-Y:*'PRB_TP1_Y'**/**TOL-MIN:*'MinCoordToleranceY'**/**TOL-MAX:*'MaxCoordToleranceY']'}
		{nb 'DPRNT[**POS-Y-MEASURE:*#150[53]**/**POS-Y-ERR:*#141[53]*]'}
		{nb 'DPRNT[]'}
		{nb 'PCLOS'}
	endif 

	if ProbeCycle eq 'PRB_Z_PLANE'
		{nb 'DPRNT[OPERATION**'ProbeCycle'**/**'upper(probe_name)']'}
		{nb 'DPRNT[**POS-Z:*'PRB_TP1_Z'**/**TOL-MIN:*'MinCoordToleranceZ'**/**TOL-MAX:*'MaxCoordToleranceZ']'}
		{nb 'DPRNT[**POS-Z-MEASURE:*#150[53]**/**POS-Z-ERR:*#142[53]*]'}
		{nb 'DPRNT[]'}
		{nb 'PCLOS'}
	endif 
endp 

