@plane_data

endp
;-------------------------------------------------------------------------------------------------------------------------

@start_program
	{nb 'G0'}
	call @machine_plane
	call @Usr_ResetSoft
	call @Usr_ZeroReturnZ
	call @Usr_ZeroReturnY
	call @Usr_ZeroReturnRot
	call @absolute_mode

endp
;-------------------------------------------------------------------------------------------------------------------------

@end_program

	call @Usr_ShowerOff
	call @Usr_CoolantOff
	call @Usr_SpindleOff
	call @Usr_ZeroReturnZ
	call @Usr_ZeroReturnY
	call @Usr_ZeroReturnRot
	call @absolute_mode

endp
;-------------------------------------------------------------------------------------------------------------------------

@end_of_file
	{nb}
	{nb 'N999'}
	{nb 'M30'}
	{nb}

endp
;-------------------------------------------------------------------------------------------------------------------------

@home_number 

endp
;-------------------------------------------------------------------------------------------------------------------------

@change_tool 
	call @Usr_ChangeToolReset
	
	if position == 1
		call @Usr_ZeroReturnRot
		call @absolute_mode
	endif

	b_FirstRapid = True
	b_SpindleOn = False
	b_FirstJob = True
	b_ChangeTool = True


endp
;-------------------------------------------------------------------------------------------------------------------------

@turn_change_tool 
	b_FirstRapid = True
	b_SpindleOn = False
	b_FirstJob = True
	b_ChangeTool = True
endp 
;-------------------------------------------------------------------------------------------------------------------------

@start_of_job 

	call @Usr_XYZFormat
	call @Usr_JobName

	b_FirstJob = False
endp
;--------------------

@end_of_job

	call @Usr_IndexOff
	call @Usr_X5Off

	if !X5_job
		if tool_start_plane > zlpos
			gcode = 0
			{nb gcode 'Z' tool_start_plane}
		endif
	endif
	{nb}

	b_CoolantOn = False
	b_ChangeTool = False
	i_SavedJobMachineType = job_machine_type
endp
;-------------------------------------------------------------------------------------------------------------------------

@m_feed_spin   				; Alway called by @start_of_job, Doesn't called by @drill	

	if change(spin) == True
		call @Usr_SpindleOn
	endif

	call @Usr_CoolantOn
endp
;-------------------------------------------------------------------------------------------------------------------------

@rapid_move				; Caution : change(xpos),change(ypos), change(zpos) is initialize to True when 1st Call @rapid_move
	gcode = 0
	if job_machine_type == Milling
		if b_FirstRapid == True
			if b_ChangeTool
				call @Usr_ToolCallPrepost
			else 
				{nb 'G90 ' gcode:'<G>5.0(p)<  >' xlpos ylpos}
				{nb '    ' zlpos}
			endif
			call @Usr_CoolantOn
			b_FirstRapid = False
		else
			{nb}
			if change(gcode) == True
				{gcode:'<G>5.0(p)<  >'}
			else
				{'    '}
			endif
			{[xlpos] [ylpos] [zlpos]}
		endif
	else 
		if b_FirstRapid == True
			if b_ChangeTool
				call @Usr_ToolCallPrepost
			else 
				{nb 'G90 ' gcode:'<G>5.0(p)<  >' xopos}
				{nb '    ' zopos}
			endif 
			b_FirstRapid = False
		else
			{nb}
			if change(gcode) == True
				{gcode:'<G>5.0(p)<  >'}
			else
				{'    '}
			endif
			{[xopos] [zopos]}
		endif
	endif
endp
;-------------------------------------------------------------------------------------------------------------------------


@move_5x
	gcode = 0
	if b_FirstRapid == True
		call @Usr_ToolCallPrepost
		{nb 'G90 ' gcode:'<G>5.0(p)<  >' xhpos yhpos apos bpos}
		{nb '    ' zhpos}
		call @Usr_CoolantOn
		b_FirstRapid = False
	else
		{nb}
		if change(gcode) == True
			{gcode:'<G>5.0(p)<  >'}
		else
			{'    '}
		endif
		{xhpos yhpos zhpos apos bpos}
	endif
endp
;-------------------------------------------------------------------------------------------------------------------------

@line
	gcode = 1
	{nb}
	if change(gcode) == True
		{gcode}
	else
		{'    '}
	endif

	if job_machine_type == Milling
		{[xlpos] [ylpos] [zlpos]}
	else
		{[xopos] [zopos]}
	endif 
	{[feed]}

endp
;-------------------------------------------------------------------------------------------------------------------------

@line_5x
	gcode = 1
	{nb}
	if change(gcode) == True
		{gcode}
	else
		{'    '}
	endif

	{xhpos yhpos zhpos apos bpos [feed]}

endp
;-------------------------------------------------------------------------------------------------------------------------


@arc
	if arc_direction == ccw
		gcode = 3
	else		;cw
		gcode = 2
	endif	

	{nb}
	if change(gcode) == True
		{gcode}
	else
		{'   '}
	endif
	{[xlpos] [ylpos] [zlpos]}

	if arc_size == 360 OR job_type == 'thread'
		if arc_plane == XY
			{' I' xlcenter_rel  ' J' ylcenter_rel}
		endif
		if arc_plane == YZ
			{' J' xlcenter_rel ' K' ylcenter_rel}
		endif
		if arc_plane == ZX
			{' K' xlcenter_rel ' I' ylcenter_rel}
		endif
	else
		if arc_size >= 180 AND job_type <> 'thread'
			radius = -radius
		endif
		{' R' radius ' '}
	endif
	{[feed]}
endp
;-------------------------------------------------------------------------------------------------------------------------

@compensation

	if side == COMP_LEFT 
		gcode = 41
		{nb gcode 'D' job_d_offset ' '}
	endif
	if side == COMP_RIGHT 
		gcode = 42
		{nb gcode 'D' job_d_offset ' '}
	endif
	if side == COMP_OFF 
		gcode = 40
		{nb gcode}
	endif 
endp
;-------------------------------------------------------------------------------------------------------------------------

@delay
	gcode = 4
	{nb gcode 'P' delay_period:integer_def_f}
endp
;-------------------------------------------------------------------------------------------------------------------------

@message
	; {nb, '(', message, ')'}   		
endp
;-------------------------------------------------------------------------------------------------------------------------

@drill	
				
	gcode = 90
	{nb gcode}	
	skipline = False
	b_FirstRapid = False
	call @rapid_move			

	if drill_type == G81
		gcode = 81
	endif
	if drill_type == G82
		gcode = 82
	endif
	if drill_type == G83
		gcode = 83
	endif
	if drill_type == G77 
		gcode = 77
		{nb 'M19'}				
	endif
	if drill_type == G85
		gcode = 85
	endif
	if drill_type == G86
		gcode = 86
	endif

	{nb 'G98 ' gcode  'Z' drill_lower_zl ' R' drill_upper_zl}

	if drill_type == G83
		{' Q' down_step}
	endif

	if drill_type == G77
		local string pitch_label
		local numeric thd_pitch
		if inch_pitch == 1	;use '1' instead of 'True' for SC2013/14 competibility, SC2013 drill_opt defined as numeric (auto)
			pitch_label = 'J'
			thd_pitch = 25.4/tool_drill_lead	
		else
			pitch_label = 'I'
			thd_pitch = tool_drill_lead
		endif
		{' Q' step_down ' ' pitch_label thd_pitch ' ' spin}
	endif
	if drill_type == G82 
		{' P' delay:integer_def_f}
	endif

	if drill_type <> G77
		{[' ' feed]}
	endif

endp
;-------------------------------------------------------------------------------------------------------------------------

@drill_point
	if first_drill == False
		if drill_type == G77
			{nb '    M19'}
		endif
		{nb '   ' [xlpos] [ylpos] [zlpos]}
	endif
endp
;-------------------------------------------------------------------------------------------------------------------------

@end_drill
	gcode = 80
	{nb gcode}
endp
;-------------------------------------------------------------------------------------------------------------------------

@loop_matrix_info
	; Can not run in DNC mode
endp
;-------------------------------------------------------------------------------------------------------------------------

@loop					; Can not run in DNC mode
	local integer var_num
    
	var_num = loop_level + 20
	{nb '#' var_num ' = 0'}
	{nb 'WHILE [#' var_num ' LT ' loop_count '] DO ' loop_level}
     
endp
;-------------------------------------------------------------------------------------------------------------------------

@end_loop				; Can not run in DNC mode

	local integer var_num

	var_num = loop_level + 20
	{nb '#' var_num ' = #' var_num ' + 1'}
	{nb 'G' home_number}
	{nb 'END ' loop_level}
endp
;-------------------------------------------------------------------------------------------------------------------------

@change_ref_point						; SolidCAM use incremental Xhome, Yhome, Zhome

	gcode = 52	
    							
	n_G52XLocalCS = n_G52XLocalCS + Xhome						
	n_G52YLocalCS = n_G52YLocalCS + Yhome
	n_G52ZLocalCS = n_G52ZLocalCS + Zhome
        
	if next_command <> '@change_ref_point'			;;;;; Skip double or triple @change_ref_point for Transform>Matrix, however equation above always update latest G52XYZLocal
    		    	
		if ref_point_init == True
			{nb'G90 ' gcode 'X0. Y0. Z0.'}					; G90 added 11:17 AM 2006/June/05
      
		else
			{nb'G90 ' gcode 'X' n_G52XLocalCS ' Y' n_G52YLocalCS ' Z' n_G52ZLocalCS}
   
		endif
	endif

	; Cancelation of G52 at reset/CLR depend on the parameter setting, bit 6 of parameter 3402 or RLC bit 3 of parameter 1202 (set to 1 = Cancel)
endp
;-------------------------------------------------------------------------------------------------------------------------

@mirror
	if mirror_type == MIRROR_OFF 
		{nb 'G50.1 X0 Y0'}
	else
		{nb 'G51.1 '}
		if mirror_type == MIRROR_X 
			{'X1 Y0'}
		endif
		if mirror_type == MIRROR_Y 
			{'X0 Y1'}
		endif
		if mirror_type == MIRROR_XY 
			{'X1 Y1'}
		endif
	endif
endp
;-------------------------------------------------------------------------------------------------------------------------

@rotate								; SolidCAM angle is incremental
	if rotate_cancel == True
		gcode = 69
		{nb gcode}
		n_AngleRotUpd = 0
	else
		n_AngleRotUpd = n_AngleRotUpd + angle
		gcode = 68
		{nb gcode 'X0 Y0 R' n_AngleRotUpd}	 ; X0 Y0 , R angle is absolute value. G91 G68 X0 Y0 R angle not effective
	endif
endp
;-------------------------------------------------------------------------------------------------------------------------

@transform_info
		
	;transform_type:Fourth_Axis(4),Translate(3),Rotate(2),Mirror(1) mirror_type:none,mirror_x(1),mirror_y(2), mirror_xy(3)
	;angle, xhome yhome zhome 
	{nb,'(TRANSFORM :'}
	if transform_type == 4
		{' FOURTH AXIS ANGLE: ' angle}
	endif
	if transform_type == 3
		{' TRANSLATE X' xhome ' Y' yhome ' Z' zhome}
	endif
	if transform_type == 2
		{' ROTATE ANGLE: ' angle}
	endif
	if transform_type == 1
		if mirror_type == 1
			{' MIRROR X'}
		endif
		if mirror_type == 2
			{' MIRROR Y'}
		endif
		if mirror_type == 1
			{' MIRROR XY'}
		endif
		if mirror_type == 0
			{' MIRROR OFF'}
		endif
	endif
	{')'}
endp
;-------------------------------------------------------------------------------------------------------------------------

@fourth_axis
	if !fourth_axis_last 
		;call @Usr_IndexOn
		b_FirstRapid = true
		b_ChangeTool = true
	endif
endp

;%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%



@Tool_Description
	{nb,'('}

	if tool_type == end_mill		; == 2		tool_user_type= 'END MILL'
		{'T' tool_number '  END MILL D' tool_diameter:'5.3(p)'};	',' - ',tool_message}
	endif
	if tool_type == 1			; == bullnose	tool_user_type= 'BULL NOSE MILL'
		{'T' tool_number '  BULL NOSE D' tool_diameter:'5.3(p)' ' R' corner_radius:'5.3(p)'};	',' - ',tool_message}
	endif
	if tool_type == ball_nose		; == 15		tool_user_type= 'BALL NOSE MILL'
		{'T' tool_number '  BALL NOSE D' tool_diameter:'5.3(p)'' R' corner_radius:'5.3(p)'};	',' - ',tool_message}
	endif
	if tool_type == 20			; == face_mill	tool_user_type= 'FACE MILL'
		{'T' tool_number '  FACE MILL D' tool_diameter:'5.3(p)'' R' corner_radius:'5.3(p)'};	',' - ',tool_message}
	endif
	if tool_type == slot_mill		; == 7		tool_user_type= 'SLOT MILL'
		{'T' tool_number '  SLOT MILL D' tool_diameter:'5.3(p)'' R' corner_radius:'5.3(p)'' THK ' cutting_tool_length:'5.3(p)'};	',' - ',tool_message}
	endif
	if tool_type == dove_mill		; == 11		tool_user_type= 'DOVE TAIL MILL'
		{'T' tool_number '  DOVE MILL D' tool_diameter:'5.3(p)'' R' corner_radius:'5.3(p)'' THK ' cutting_tool_length:'5.3(p)'};	',' - ',tool_message}
	endif
	if tool_type == taper_mill		; == 9		tool_user_type= 'TAPER MILL'
		{'T' tool_number '  TAPER MILL D' tool_diameter:'5.3(p)'' TIP D',(tool_tip_radius*2):'5.3(p)'' R' corner_radius:'5.3(p)'};	',' - ',tool_message}
	endif
	if tool_type == lollipop_mill		; == 8		tool_user_type= 'LOLLIPOP MILL'
		{'T' tool_number '  LOLLIPOP D' tool_diameter:'5.3(p)'};	',' - ',tool_message}
	endif
	if tool_type == 19			; == engraving_mill		tool_user_type= 'ENGRAVING TOOL'
		{'T' tool_number '  ENGRAVING D' tool_diameter:'5.3(p)'' TIP D',(tool_tip_radius*2):'5.3(p)'' R' corner_radius:'5.3(p)'};	',' - ',tool_message}
	endif
	if tool_type == 18			; == center_drill		tool_user_type= 'CENTER DRILL'
		{'T' tool_number '  CENTER DRILL TIP D',(tool_tip_radius*2):'5.3(p)'};	',' - ',tool_message}
	endif
	if tool_type == spot_drill		; == 21		tool_user_type= 'SPOT DRILL'
		{'T' tool_number '  SPOT DRILL D' tool_diameter:'5.3(p)'};	',' - ',tool_message}
	endif
	if tool_type == drill			; == 0		tool_user_type= 'DRILL'
		{'T' tool_number '  DRILL D' tool_diameter:'5.3(p)'};	',' - ',tool_message}
	endif
	if tool_type == chamfer_drill		; == 10		tool_user_type= 'CHAMFER DRILL'
		{'T' tool_number '  CHAMFER DRILL D' tool_diameter:'5.3(p)'' A' corner_radius:'5.3(p)'};	',' - ',tool_message}	; Angle use :corner_radius
	endif
	if tool_type == tap_mill		; == 12		tool_user_type= 'TAP'
		{'T' tool_number '  TAP D' tool_diameter:'5.3(p)'' PITCH ' tool_drill_lead:'5.3(p)'};	',' - ',tool_message}	
	endif
	if tool_type == reamer_mill		; == 16		tool_user_type= 'REAMER'
		{'T' tool_number '  REAMER D' tool_diameter:'5.3(p)'};	',' - ',tool_message}	
	endif
	if tool_type == 17			; == bore	tool_user_type= 'BORE'
		{'T' tool_number '  BORE D' tool_diameter:'5.3(p)'' R' corner_radius:'5.3(p)'};	',' - ',tool_message}	
	endif
	if tool_type == thread_mill		; == 13		tool_user_type= 'THREAD MILL'
		{'T' tool_number '  THREAD MILL D' tool_diameter:'5.3(p)'' PITCH ' tool_drill_lead:'5.3(p)'' TEETH ' tool_teeth_number};	,' - ',tool_message}	
	endif
	if tool_type == 14			; == thread_taper_milll		tool_user_type= 'THREAD TAPER'
		{'T' tool_number '  THREAD TAPER MILL D' tool_diameter:'5.3(p)'' PITCH ' tool_drill_lead:'5.3(p)'' TEETH ' tool_teeth_number};	,' - ',tool_message}	
	endif

	{')'}
endp
;-------------------

@Time_Store

	local string sL_TimeSSMMHH
	local string sL_TimeSS
	local string sL_TimeMMHH
	local string sL_TimeMM
	local string sL_TimeHH
	local integer iL_TimeSemiColon1
	local integer iL_TimeSemiColon2

	if job_time <> ''

		sL_TimeSSMMHH = rev(trim(job_time))							;s2s1:m2m1:h2h1
		iL_TimeSemiColon1 = instr(sL_TimeSSMMHH,':')						;s2s1 ':'	; Should be = 3
		sL_TimeSS = left(sL_TimeSSMMHH,(iL_TimeSemiColon1-1))					;s2s1 
		sL_TimeMMHH = Right(sL_TimeSSMMHH,(strlen(sL_TimeSSMMHH)-iL_TimeSemiColon1))	;m2m1:h2h1
		iL_TimeSemiColon2 = instr(sL_TimeMMHH,':')						;m2m1 ':'	; Should be = 3
		sL_TimeMM = left(sL_TimeMMHH,(iL_TimeSemiColon2-1))					;m2m1
		sL_TimeHH = right(sL_TimeMMHH,(strlen(sL_TimeMMHH)-iL_TimeSemiColon2))		;h2h1

		;----- Seconds
		n_TimeSecs = tonum(rev(sL_TimeSS))
		n_TimeAccSecs = n_TimeAccSecs + n_TimeSecs
		
		;----- Minutes
		n_TimeMins = tonum(rev(sL_TimeMM))		
		n_TimeAccMins = n_TimeAccMins + n_TimeMins
		
		;----- Hours
		nTimeHrs = tonum(rev(sL_TimeHH))	
		n_TimeAccHrs = n_TimeAccHrs + nTimeHrs

	endif
endp
;-------------------

@Time_TotalCal

	local numeric n_TimeTotalSecs
	local numeric n_TimeTotalMins 
	local numeric n_TimeTotalHrs 
	local numeric n_TimeTotalTemp

	;----- Seconds
	n_TimeTotalSecs = mod(n_TimeAccSecs,60)

	;----- Minutes
	n_TimeTotalTemp = int(n_TimeAccSecs/60)
	n_TimeAccMins = n_TimeAccMins + n_TimeTotalTemp
	n_TimeTotalMins = mod(n_TimeAccMins,60)

	;----- Hours
	n_TimeTotalTemp = int(n_TimeAccMins/60)
	n_TimeAccHrs = n_TimeAccHrs + n_TimeTotalTemp
	n_TimeTotalHrs = n_TimeAccHrs
	
	{nb '(TOTAL Machine Time: '  n_TimeTotalHrs:'2.0(p)' ' HOURS ' n_TimeTotalMins:'2.0(p)' ' MINUTES ' n_TimeTotalSecs:'2.0(p)' ' SECONDS )'}
endp


